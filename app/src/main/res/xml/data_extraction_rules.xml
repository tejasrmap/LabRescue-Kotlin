<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Disallow sensitive user credential databases and preferences from cloud sync -->
        <exclude domain="database" path="labrescue.db" />
        <exclude domain="database" path="labrescue.db-wal" />
        <exclude domain="database" path="labrescue.db-shm" />
        <exclude domain="sharedpref" path="labrescue_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="labrescue.db" />
        <exclude domain="database" path="labrescue.db-wal" />
        <exclude domain="database" path="labrescue.db-shm" />
        <exclude domain="sharedpref" path="labrescue_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
